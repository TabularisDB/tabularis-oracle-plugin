{
  "name": "oracle",
  "version": "0.1.0",
  "kind": "driver",
  "description": "Oracle Database driver. Connects to Oracle 12c+ (including Free/XE, Autonomous and RDS) via the Oracle Instant Client.",
  "engine": "oracle",
  "paradigms": [
    "sql"
  ],
  "default_port": 1521,
  "default_username": "system",
  "executable": "oracle-plugin",
  "capabilities": {
    "schemas": true,
    "views": true,
    "routines": true,
    "file_based": false,
    "folder_based": false,
    "connection_string": true,
    "connection_string_example": "oracle://system:oracle@localhost:1521/FREEPDB1",
    "identifier_quote": "\"",
    "alter_primary_key": true,
    "inline_pk": false,
    "auto_increment_keyword": "GENERATED BY DEFAULT AS IDENTITY",
    "serial_type": "",
    "alter_column": true,
    "create_foreign_keys": true,
    "no_connection_required": false,
    "manage_tables": true,
    "readonly": false,
    "supports_ssl": true
  },
  "settings": [
    {
      "key": "client_lib_dir",
      "label": "Oracle Client library directory",
      "type": "string",
      "required": false,
      "description": "Directory containing the Oracle Instant Client libraries (oci.dll / libclntsh). Leave empty if the client is already on the system PATH / LD_LIBRARY_PATH."
    }
  ],
  "data_types": [
    {
      "name": "NUMBER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": true,
      "supports_auto_increment": true
    },
    {
      "name": "INTEGER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false,
      "supports_auto_increment": true
    },
    {
      "name": "FLOAT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BINARY_FLOAT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BINARY_DOUBLE",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "VARCHAR2",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "255"
    },
    {
      "name": "NVARCHAR2",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "255"
    },
    {
      "name": "CHAR",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1"
    },
    {
      "name": "NCHAR",
      "category": "string",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "1"
    },
    {
      "name": "CLOB",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "NCLOB",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BLOB",
      "category": "binary",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "RAW",
      "category": "binary",
      "requires_length": true,
      "requires_precision": false,
      "default_length": "2000"
    },
    {
      "name": "DATE",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TIMESTAMP",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TIMESTAMP WITH TIME ZONE",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TIMESTAMP WITH LOCAL TIME ZONE",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "INTERVAL YEAR TO MONTH",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "INTERVAL DAY TO SECOND",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "JSON",
      "category": "json",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "XMLTYPE",
      "category": "other",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BOOLEAN",
      "category": "other",
      "requires_length": false,
      "requires_precision": false
    }
  ]
}
